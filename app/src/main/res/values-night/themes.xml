<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode. -->
    <style name="Theme.Personalprofile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/border_light</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/white</item>
        <item name="colorSecondaryVariant">@color/text_tertiary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/black_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/black_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Circular Shape Appearance Overlay for Profile Image -->
    <style name="CircularImageView">
        <item name="cornerSize">50%</item>
    </style>
</resources>